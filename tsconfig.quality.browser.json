{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "apps/*/src/**/*",
    "tests/**/*"
  ]
}
