@page "/"
@rendermode InteractiveServer
@using Tipolox.LitGrid.Blazor
<h1>Fictional Blazor properties</h1>
<output id="requests">@requests</output>
<DataGrid TItem="Row" Columns="columns" Config="config" ExternalState="state" OnQueryChange="QueryChanged" />
@code {
    public record Row(string id, string name, string amount);
    private int requests;
    private GridConfig config = new() { QueryMode = "external", Selection = new() { Mode = SelectionMode.Row, RowKey = "id", ScopeKey = "fictional/account-a" } };
    private GridColumn[] columns = [new() { Key = "name", Header = "Property" }, new() { Key = "amount", Sortable = false, Filterable = false }];
    private GridExternalState<Row> state = new() { RequestId = 1, Query = new() { PageSize = 20 }, Rows = [new("unit-a", "Fictional Alpha", "9007199254740993.01")], Total = new() { Kind = "known", TotalRows = 352 } };
    private void QueryChanged(GridQueryChangeDetail detail) {
        requests++;
        state = new() { RequestId = detail.RequestId, Query = detail.Query, Rows = [new("unit-b", $"Fictional page {detail.Query.PageIndex + 1}", "-2.00")], Total = new() { Kind = "known", TotalRows = 352 } };
    }
}
