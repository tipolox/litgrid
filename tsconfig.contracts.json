{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "packages/grid-web/tests/*.typecheck.ts",
    "packages/grid-react/src/jsx-elements.d.ts",
    "packages/grid-react/src/**/*.test.tsx",
    "packages/grid-react/src/**/*.test.ts",
    "packages/grid-vue/src/**/*.test.ts",
    "packages/grid-angular/src/**/*.test.ts",
    "tests/contracts/**/*.ts"
  ]
}
